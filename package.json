{
  "name": "@heckle-it/design",
  "version": "0.1.0",
  "description": "Colours, type, shape and motion for Heckle, as TypeScript values and a Tailwind CSS theme",
  "license": "Apache-2.0",
  "homepage": "https://heckle.it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heckleit/design.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "pnpm": "^12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:workflows": "actionlint && zizmor .github",
    "typecheck": "tsc",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "prepack": "pnpm build",
    "check": "pnpm format:check && pnpm lint && pnpm lint:workflows && pnpm typecheck && pnpm test && pnpm build"
  },
  "prettier": {},
  "dependencies": {
    "@fontsource-variable/rethink-sans": "^5.3.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/node": "^4.3.3",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
